# Copy this file to .env.local and fill in the two values from
# Supabase -> Project Settings -> API.
#
# Both are PUBLIC by design. The anon key is safe in a browser because every
# table is protected by Row Level Security (see supabase/schema.sql).
#
# NEVER put the service_role key here, or anywhere with a NEXT_PUBLIC_ prefix.
# It bypasses Row Level Security entirely.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
