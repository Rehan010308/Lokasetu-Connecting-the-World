{
  "name": "lokasetu",
  "version": "5.0.0",
  "private": true,
  "description": "LokaSetu \u2014 a hyperlocal work network for India: profiles, community posts, connections and Rapido-style price negotiation, on Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx lib/selftest.ts",
    "ssr": "tsx --tsconfig tsconfig.ssr.json ssr-check.tsx",
    "verify": "npm run typecheck && npm test",
    "version:sync": "node scripts/version.mjs",
    "preview": "tsx --tsconfig tsconfig.ssr.json design-preview.tsx && tsx --tsconfig tsconfig.ssr.json design-preview.tsx --dark"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "lucide-react": "^0.469.0",
    "next": "15.1.9",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
