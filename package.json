{
  "name": "lokasetu",
  "version": "4.1.8",
  "private": true,
  "description": "LokaSetu - AI-powered hyperlocal employment platform for India's informal workforce",
  "scripts": {
    "dev": "node scripts/doctor.mjs --warn && next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx lib/selftest.ts",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "doctor:fix": "node scripts/doctor.mjs --fix",
    "ssr": "tsx --tsconfig tsconfig.ssr.json ssr-check.tsx",
    "version:sync": "node scripts/version.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "next": "15.1.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "motion": "12.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
